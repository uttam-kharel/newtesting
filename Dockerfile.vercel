# syntax=docker/dockerfile:1

# ============================================================================
# Dockerfile.vercel — deploy Laravel on Vercel using the official container
# model (FrankenPHP), per https://vercel.com/kb/guide/deploy-php-on-vercel-with-docker
#
# Three stages:
#   1. vendor  — install production Composer dependencies
#   2. assets  — build frontend assets with Vite + Tailwind
#   3. runtime — FrankenPHP serving /app/public on Vercel's $PORT
# ============================================================================

# ---------------------------------------------------------------------------
# Stage 1 — PHP dependencies
# ---------------------------------------------------------------------------
FROM composer:2 AS vendor
WORKDIR /app

COPY composer.json composer.lock ./

# --no-scripts: Laravel's post-install hook (package:discover) needs the full
# app bootstrapped, so we run it later in the runtime stage instead.
RUN composer install \
    --no-dev \
    --no-interaction \
    --no-progress \
    --no-scripts \
    --prefer-dist \
    --optimize-autoloader

# ---------------------------------------------------------------------------
# Stage 2 — Frontend assets
# ---------------------------------------------------------------------------
FROM node:22-alpine AS assets
WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund

COPY . .
RUN npm run build

# ---------------------------------------------------------------------------
# Stage 3 — Runtime (FrankenPHP)
# ---------------------------------------------------------------------------
FROM dunglas/frankenphp:1-php8.4

WORKDIR /app

# PostgreSQL driver for Neon, plus the pgsql extension.
RUN install-php-extensions pdo_pgsql pgsql

# Run as an unprivileged user. Vercel always provides an unprivileged $PORT,
# so we can drop the CAP_NET_BIND_SERVICE capability FrankenPHP has by default.
ARG USER=appuser
RUN useradd ${USER} \
    && setcap -r /usr/local/bin/frankenphp \
    && chown -R ${USER}:${USER} /config/caddy /data/caddy

# Production dependencies.
COPY --from=vendor /app/vendor ./vendor

# Application code (everything not excluded by .dockerignore).
COPY . .

# Built frontend assets.
COPY --from=assets /app/public/build ./public/build

# Web server config + container entrypoint.
COPY Caddyfile /etc/caddy/Caddyfile
COPY entrypoint.sh /app/entrypoint.sh
RUN chmod +x /app/entrypoint.sh

# Env-independent caches. Config is intentionally NOT cached here: Vercel
# injects environment variables at runtime, so we rebuild caches on boot.
RUN mkdir -p /app/bootstrap/cache \
    && php artisan package:discover --ansi \
    && php artisan view:cache \
    && php artisan event:cache

# Storage must be writable by the non-root user.
RUN chown -R ${USER}:${USER} /app/storage /app/bootstrap/cache

USER ${USER}

ENV PORT=80

ENTRYPOINT ["/app/entrypoint.sh"]
CMD ["frankenphp", "run", "--config", "/etc/caddy/Caddyfile"]
